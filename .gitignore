.pytest_cache/
.DS_Store

# runtime outputs / recordings
output/
*.h264.mp4

# 模型: MediaPipe 官方产物(7.5MB), 首次运行自动下载
# 见 src/manual_tracking/paths.py 的 ensure_model()
models/

# 样片不入库: assets/sample.mp4 是原作者的抖音视频(12 秒, 有人脸), 公开仓库
# 不能替人传播。它是 docs 里全部实测数字的基准, 所以第四层 tools/e2e_check.py
# 要你自己放一段双手素材到这个路径(基线数字按自己的素材重标, 见 README)。
assets/

# editor —— .vscode/ **是跟踪的**: tasks/launch/settings 写的是本项目怎么跑
# (-m 包模式、PYTHONPATH=src、钉 venv 解释器), 不是个人偏好; README 提到的
# Cmd+Shift+B / F5 / ▶ 全靠它们, 新 clone 里没有就等于没写。
.idea/
